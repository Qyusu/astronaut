# API key setting
OPENAI_API_KEY="xxxx"
# GOOGLE_API_KEY="xxxx"
# ANTHROPIC_API_KEY="xxxx"

# chat model setting
CHAT_PLATFORM="openai"
DEFAULT_LIGHT_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
DEFAULT_MODEL_VERSION="gpt-5.4-2026-03-05"
# EXPANDING_MODEL_VERSION="gpt-5.4-2026-03-05"
# IDEA_MODEL_VERSION="gpt-5.4-2026-03-05"
# SCORING_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
# SUMMARY_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
# EXPERT_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
# REFLECTION_MODEL_VERSION="gpt-5.4-2026-03-05"
# REFERENCE_EXTRACTION_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
# CODE_MODEL_VERSION="gpt-5.4-2026-03-05"
# VALIDATION_MODEL_VERSION="gpt-5.4-mini-2026-03-17"
# REVIEW_MODEL_VERSION="gpt-5.4-2026-03-05"

# embedding setting
EMBEDDING_PLATFORM="openai"
EMBEDDING_MODEL_VERSION="text-embedding-3-small"
EMBEDDING_DIM = 1536

# pinecone setting
PINECONE_API_KEY="xxxx"
PENNLYLANE_INDEX_NAME="pennylane"
ARXIV_INDEX_NAME="arxiv"

# LangSmith setting
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="xxxx"
LANGCHAIN_API_KEY="xxxx"
LANGCHAIN_PROJECT="xxxx"
